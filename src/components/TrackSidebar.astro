---
import Default from '@astrojs/starlight/components/Sidebar.astro';

const routeId = String(Astro.locals.starlightRoute.id ?? '');
const isEnglish = routeId === 'en' || routeId.startsWith('en/');
const normalizedId = isEnglish ? routeId.replace(/^en\/?/, '') : routeId;
const tracks = [
	{ code: '01', slug: 'programming-basics', ar: 'أساسيات البرمجة والويب', en: 'Programming & Web Basics' },
	{ code: 'C++', slug: 'cpp', ar: 'لغة C++', en: 'The C++ Language' },
	{ code: 'PHP', slug: 'php', ar: 'لغة PHP', en: 'The PHP Language' },
	{ code: 'OPS', slug: 'php-runtime', ar: 'تشغيل PHP والإنتاج', en: 'PHP Runtime & Production' },
	{ code: 'OOP', slug: 'oop', ar: 'البرمجة كائنية التوجه', en: 'Object-Oriented Programming' },
	{ code: 'SEC', slug: 'auth', ar: 'الأمان والهوية والصلاحيات', en: 'Security, Identity & Access' },
	{ code: 'DB', slug: 'database', ar: 'قواعد البيانات وPDO', en: 'Databases & PDO' },
];
const currentIndex = tracks.findIndex(
	(track) => normalizedId === track.slug || normalizedId.startsWith(track.slug + '/'),
);
const pickerLabel = isEnglish ? 'Choose a learning track' : 'اختر مسار التعلّم';
const currentTrack = currentIndex >= 0 ? tracks[currentIndex] : null;
---

<track-sidebar class="track-sidebar" data-track-index={currentIndex}>
	<div class="track-picker">
		<button
			class="track-trigger"
			type="button"
			aria-expanded="false"
			aria-controls="track-menu"
			aria-haspopup="listbox"
		>
			<span class="trigger-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24"><path d="m12 2 9 4.5-9 4.5-9-4.5L12 2Zm-7 8.2 7 3.5 7-3.5v2.6l-7 3.5-7-3.5v-2.6Zm0 5 7 3.5 7-3.5v2.6l-7 3.5-7-3.5v-2.6Z"/></svg>
			</span>
			<span class="trigger-copy">
				<small>{pickerLabel}</small>
				<strong>{currentTrack ? (isEnglish ? currentTrack.en : currentTrack.ar) : (isEnglish ? 'Select a track' : 'اختر المسار')}</strong>
			</span>
			<svg class="trigger-arrow" aria-hidden="true" viewBox="0 0 24 24"><path d="m7 9 5 5 5-5H7Z"/></svg>
		</button>

		<div class="track-menu-shell">
			<div id="track-menu" class="track-menu" role="listbox" aria-label={pickerLabel}>
				{tracks.map((track, index) => (
					<a
						class="track-option"
						href={(isEnglish ? '/en/' : '/') + track.slug + '/'}
						role="option"
						aria-selected={index === currentIndex ? 'true' : 'false'}
						data-active={index === currentIndex ? 'true' : 'false'}
					>
						<span class="option-code" aria-hidden="true">{track.code}</span>
						<span>{isEnglish ? track.en : track.ar}</span>
						<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6-1.4 1.4L12.2 12l-4.6 4.6L9 18Z"/></svg>
					</a>
				))}
			</div>
		</div>
	</div>

	<div class="track-lessons">
		{currentIndex === -1 && (
			<p class="track-empty">
				{isEnglish
					? 'Choose a track to display its lessons here.'
					: 'اختر مسارًا لعرض موضوعاته هنا.'}
			</p>
		)}
		<Default><slot /></Default>
	</div>
</track-sidebar>

<script>
	class TrackSidebar extends HTMLElement {
		connectedCallback() {
			const trigger = this.querySelector<HTMLButtonElement>('.track-trigger');
			const menuShell = this.querySelector<HTMLElement>('.track-menu-shell');
			if (!trigger || !menuShell || trigger.dataset.ready === 'true') return;
			trigger.dataset.ready = 'true';

			const lessonItems = this.querySelectorAll<HTMLElement>('.top-level > li > details > ul > li');
			lessonItems.forEach((item, index) => {
				item.style.setProperty('--lesson-order', String(index));
			});
			requestAnimationFrame(() => this.classList.add('is-ready'));

			const setOpen = (open: boolean) => {
				this.classList.toggle('is-picker-open', open);
				trigger.setAttribute('aria-expanded', String(open));
			};

			trigger.addEventListener('click', () => {
				setOpen(trigger.getAttribute('aria-expanded') !== 'true');
			});

			this.querySelectorAll<HTMLAnchorElement>('.track-option').forEach((option) => {
				option.addEventListener('click', () => {
					this.classList.add('is-switching');
					setOpen(false);
				});
			});

			document.addEventListener('pointerdown', (event) => {
				if (!this.contains(event.target as Node)) setOpen(false);
			});

			this.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') {
					setOpen(false);
					trigger.focus();
				}
			});
		}
	}

	if (!customElements.get('track-sidebar')) {
		customElements.define('track-sidebar', TrackSidebar);
	}
</script>

<style>
	.track-sidebar {
		display: flex;
		flex: 1;
		flex-direction: column;
		width: 100%;
		min-height: 100%;
	}

	.track-picker {
		position: relative;
		flex: none;
		margin: -1.25rem -1rem 0;
		padding: 1rem;
		border-bottom: 1px solid var(--docs-border);
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--sl-color-accent) 9%, transparent), transparent 60%),
			var(--sl-color-bg-sidebar);
		box-shadow: inset 0 -1px 0 rgb(255 255 255 / 2%), 0 10px 26px rgb(2 6 23 / 5%);
	}

	.track-trigger {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		min-height: 3.75rem;
		padding: 0.65rem 0.75rem;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 25%, var(--docs-border));
		border-radius: 0.9rem;
		background: color-mix(in srgb, var(--sl-color-bg) 78%, transparent);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 4%);
		color: var(--sl-color-white);
		font: inherit;
		text-align: start;
		cursor: pointer;
		transition: border-color 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
	}

	.track-trigger:hover,
	.track-sidebar.is-picker-open .track-trigger {
		border-color: color-mix(in srgb, var(--sl-color-accent) 52%, var(--docs-border));
		background: color-mix(in srgb, var(--sl-color-accent) 7%, var(--sl-color-bg));
		box-shadow: 0 10px 26px color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
	}

	.track-trigger:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.trigger-icon {
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		place-items: center;
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
		color: var(--sl-color-text-accent);
	}

	.trigger-icon svg { width: 1.15rem; height: 1.15rem; fill: currentColor; }
	.trigger-copy { display: grid; min-width: 0; gap: 0.12rem; }
	.trigger-copy small {
		color: var(--sl-color-gray-3);
		font-size: 0.7rem;
		font-weight: 520;
		letter-spacing: 0;
	}
	.trigger-copy strong {
		overflow: hidden;
		color: var(--sl-color-white);
		font-size: 0.88rem;
		font-weight: 620;
		line-height: 1.35;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.trigger-arrow {
		width: 1rem;
		height: 1rem;
		fill: var(--sl-color-gray-3);
		transition: transform 160ms ease;
	}

	.track-sidebar.is-picker-open .trigger-arrow { transform: rotate(180deg); }

	.track-menu-shell {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		transition: grid-template-rows 180ms ease, opacity 140ms ease;
	}

	.track-sidebar.is-picker-open .track-menu-shell {
		grid-template-rows: 1fr;
		opacity: 1;
	}

	.track-menu {
		display: grid;
		gap: 0.25rem;
		overflow: hidden;
	}

	.track-sidebar.is-picker-open .track-menu {
		margin-top: 0.6rem;
		padding-top: 0.55rem;
		border-top: 1px solid var(--docs-border);
	}

	.track-option {
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.65rem;
		min-height: 2.75rem;
		padding: 0.4rem 0.55rem;
		border: 1px solid transparent;
		border-radius: 0.7rem;
		color: var(--sl-color-gray-2);
		font-size: 0.82rem;
		font-weight: 560;
		line-height: 1.35;
		text-decoration: none;
		transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease;
	}

	.track-option:hover,
	.track-option:focus-visible {
		border-color: color-mix(in srgb, var(--sl-color-accent) 20%, transparent);
		background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
		color: var(--sl-color-white);
		outline: none;
	}

	.track-option[data-active='true'] {
		background: color-mix(in srgb, var(--sl-color-accent) 11%, transparent);
		color: var(--sl-color-text-accent);
	}

	.option-code {
		display: grid;
		height: 1.75rem;
		place-items: center;
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--sl-color-accent) 9%, transparent);
		color: var(--sl-color-text-accent);
		font: 650 0.62rem/1 var(--sl-font-mono);
	}

	.track-option > svg {
		width: 0.9rem;
		height: 0.9rem;
		fill: currentColor;
		opacity: 0.55;
	}

	[dir='rtl'] .track-option > svg { transform: scaleX(-1); }

	.track-empty {
		margin: 0.35rem 1rem 1rem;
		color: var(--sl-color-gray-3);
		font-size: 0.86rem;
		line-height: 1.7;
	}

	.track-lessons {
		flex: 1;
		padding-top: 0.8rem;
		font-family: var(--sl-font);
		font-weight: 450;
		transition: opacity 160ms ease, transform 160ms ease;
	}

	.track-sidebar.is-switching .track-lessons {
		opacity: 0.38;
		transform: translateY(5px);
	}

	.track-sidebar.is-switching .track-picker::after {
		content: "";
		display: block;
		position: absolute;
		inset: auto 1rem 0;
		height: 2px;
		border-radius: 999px;
		background: var(--sl-color-accent);
		transform-origin: left;
		animation: track-loading 180ms ease both;
	}

	.track-lessons :global(.top-level > li) { display: none; }
	.track-sidebar[data-track-index='0'] .track-lessons :global(.top-level > li:nth-child(1)),
	.track-sidebar[data-track-index='1'] .track-lessons :global(.top-level > li:nth-child(2)),
	.track-sidebar[data-track-index='2'] .track-lessons :global(.top-level > li:nth-child(3)),
	.track-sidebar[data-track-index='3'] .track-lessons :global(.top-level > li:nth-child(4)),
	.track-sidebar[data-track-index='4'] .track-lessons :global(.top-level > li:nth-child(5)),
	.track-sidebar[data-track-index='5'] .track-lessons :global(.top-level > li:nth-child(6)),
	.track-sidebar[data-track-index='6'] .track-lessons :global(.top-level > li:nth-child(7)) {
		display: block;
	}

	.track-lessons :global(.top-level > li > details > summary) {
		margin: 0 0.75rem 0.4rem;
		padding: 0.65rem 0.75rem;
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
		color: var(--sl-color-text-accent);
		font-weight: 620;
	}

	.track-lessons :global(.top-level > li > details > ul > li) {
		opacity: 0;
		transform: translateY(7px);
		transition: opacity 220ms ease, transform 220ms ease;
		transition-delay: calc(var(--lesson-order, 0) * 18ms);
	}

	.track-sidebar.is-ready .track-lessons :global(.top-level > li > details > ul > li) {
		opacity: 1;
		transform: translateY(0);
	}

	@keyframes track-loading {
		from { transform: scaleX(0); }
		to { transform: scaleX(1); }
	}

	@media (prefers-reduced-motion: reduce) {
		.track-trigger,
		.trigger-arrow,
		.track-menu-shell,
		.track-lessons,
		.track-lessons :global(.top-level > li > details > ul > li) {
			transition: none;
		}

		.track-sidebar.is-switching .track-picker::after { animation: none; }
	}
</style>
