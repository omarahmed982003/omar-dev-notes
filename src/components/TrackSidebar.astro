---
import Default from '@astrojs/starlight/components/Sidebar.astro';

const routeId = String(Astro.locals.starlightRoute.id ?? '');
const isEnglish = routeId === 'en' || routeId.startsWith('en/');
const normalizedId = isEnglish ? routeId.replace(/^en\/?/, '') : routeId;
const tracks = [
	{ slug: 'programming-basics', ar: 'أساسيات البرمجة والويب', en: 'Programming & Web Basics' },
	{ slug: 'php', ar: 'لغة PHP', en: 'The PHP Language' },
	{ slug: 'php-runtime', ar: 'تشغيل PHP والإنتاج', en: 'PHP Runtime & Production' },
	{ slug: 'oop', ar: 'البرمجة كائنية التوجه', en: 'Object-Oriented Programming' },
	{ slug: 'auth', ar: 'الأمان والهوية والصلاحيات', en: 'Security, Identity & Access' },
	{ slug: 'database', ar: 'قواعد البيانات وPDO', en: 'Databases & PDO' },
];
const currentIndex = tracks.findIndex(
	(track) => normalizedId === track.slug || normalizedId.startsWith(track.slug + '/'),
);
const pickerLabel = isEnglish ? 'Choose a learning track' : 'اختر مسار التعلّم';
---

<track-sidebar class="track-sidebar" data-track-index={currentIndex}>
	<label class="track-picker">
		<span class="track-picker-label">
			<svg aria-hidden="true" viewBox="0 0 24 24">
				<path d="m12 2 10 5-10 5L2 7l10-5Zm-8 9.2 8 4 8-4V14l-8 4-8-4v-2.8Zm0 5 8 4 8-4V19l-8 4-8-4v-2.8Z"/>
			</svg>
			{pickerLabel}
		</span>
		<span class="select-shell">
			<select aria-label={pickerLabel}>
				<option value="" selected={currentIndex === -1}>
					{isEnglish ? 'Select a track…' : 'اختر المسار…'}
				</option>
				{tracks.map((track, index) => (
					<option
						value={(isEnglish ? '/en/' : '/') + track.slug + '/'}
						selected={index === currentIndex}
					>
						{isEnglish ? track.en : track.ar}
					</option>
				))}
			</select>
			<svg class="select-arrow" aria-hidden="true" viewBox="0 0 24 24">
				<path d="m7 9.5 5 5 5-5H7Z"/>
			</svg>
		</span>
	</label>

	<div class="track-lessons">
		{currentIndex === -1 && (
			<p class="track-empty">
				{isEnglish
					? 'Choose a track to display its lessons here.'
					: 'اختر مسارًا لعرض موضوعاته هنا.'}
			</p>
		)}
		<Default><slot /></Default>
	</div>
</track-sidebar>

<script>
	class TrackSidebar extends HTMLElement {
		connectedCallback() {
			const select = this.querySelector<HTMLSelectElement>('select');
			if (!select || select.dataset.ready === 'true') return;
			select.dataset.ready = 'true';

			const lessonItems = this.querySelectorAll<HTMLElement>('.top-level > li > details > ul > li');
			lessonItems.forEach((item, index) => {
				item.style.setProperty('--lesson-order', String(index));
			});
			requestAnimationFrame(() => this.classList.add('is-ready'));

			const picker = this.querySelector<HTMLElement>('.track-picker');
			picker?.addEventListener('pointermove', (event) => {
				const bounds = picker.getBoundingClientRect();
				picker.style.setProperty('--pointer-x', event.clientX - bounds.left + 'px');
				picker.style.setProperty('--pointer-y', event.clientY - bounds.top + 'px');
			});

			select.addEventListener('change', () => {
				if (!select.value) return;
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				this.classList.add('is-switching');
				select.disabled = true;
				window.setTimeout(() => {
					window.location.href = select.value;
				}, reduceMotion ? 0 : 180);
			});
		}
	}

	if (!customElements.get('track-sidebar')) {
		customElements.define('track-sidebar', TrackSidebar);
	}
</script>

<style>
	.track-sidebar {
		display: flex;
		flex: 1;
		flex-direction: column;
		width: 100%;
		min-height: 100%;
	}

	.track-picker {
		--pointer-x: 50%;
		--pointer-y: 50%;
		display: grid;
		flex: none;
		gap: 0.7rem;
		margin: -1.25rem 0 0;
		padding: 1.15rem 1rem 1.2rem;
		border: 0;
		border-bottom: 1px solid var(--docs-border);
		border-radius: 0;
		background:
			radial-gradient(circle at var(--pointer-x) var(--pointer-y), color-mix(in srgb, var(--sl-color-accent) 14%, transparent), transparent 7rem),
			linear-gradient(180deg, color-mix(in srgb, var(--sl-color-accent) 7%, var(--sl-color-bg-sidebar)), var(--sl-color-bg-sidebar));
		box-shadow: 0 1px 0 rgb(255 255 255 / 3%);
		transition: background 180ms ease;
	}

	.track-picker-label {
		display: flex;
		align-items: center;
		gap: 0.48rem;
		color: var(--sl-color-gray-2);
		font-size: 0.84rem;
		font-weight: 800;
	}

	.track-picker-label svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: var(--sl-color-text-accent);
	}

	.select-shell { position: relative; display: block; }

	select {
		width: 100%;
		min-height: 3.15rem;
		appearance: none;
		padding: 0.7rem 0.85rem;
		padding-inline-end: 2.5rem;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 24%, var(--docs-border));
		border-radius: 0.8rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
		font: inherit;
		font-size: 0.94rem;
		font-weight: 700;
		cursor: pointer;
	}

	select:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.select-arrow {
		position: absolute;
		inset-inline-end: 0.7rem;
		top: 50%;
		width: 1rem;
		height: 1rem;
		fill: var(--sl-color-gray-3);
		pointer-events: none;
		transform: translateY(-50%);
	}

	.track-empty {
		margin: 0.35rem 1rem 1rem;
		color: var(--sl-color-gray-3);
		font-size: 0.86rem;
		line-height: 1.7;
	}

	.track-lessons {
		flex: 1;
		padding-top: 0.8rem;
		transition: opacity 160ms ease, transform 160ms ease;
	}

	.track-sidebar.is-switching .track-lessons {
		opacity: 0.38;
		transform: translateY(5px);
	}

	.track-sidebar.is-switching .select-shell::after {
		content: "";
		position: absolute;
		inset: auto 0 -0.45rem;
		height: 2px;
		border-radius: 999px;
		background: var(--sl-color-accent);
		transform-origin: left;
		animation: track-loading 180ms ease both;
	}

	.track-lessons :global(.top-level > li) { display: none; }
	.track-sidebar[data-track-index='0'] .track-lessons :global(.top-level > li:nth-child(1)),
	.track-sidebar[data-track-index='1'] .track-lessons :global(.top-level > li:nth-child(2)),
	.track-sidebar[data-track-index='2'] .track-lessons :global(.top-level > li:nth-child(3)),
	.track-sidebar[data-track-index='3'] .track-lessons :global(.top-level > li:nth-child(4)),
	.track-sidebar[data-track-index='4'] .track-lessons :global(.top-level > li:nth-child(5)),
	.track-sidebar[data-track-index='5'] .track-lessons :global(.top-level > li:nth-child(6)) {
		display: block;
	}

	.track-lessons :global(.top-level > li > details > summary) {
		margin: 0 0.75rem 0.4rem;
		padding: 0.65rem 0.75rem;
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
		color: var(--sl-color-text-accent);
	}

	.track-lessons :global(.top-level > li > details > ul > li) {
		opacity: 0;
		transform: translateY(7px);
		transition: opacity 220ms ease, transform 220ms ease;
		transition-delay: calc(var(--lesson-order, 0) * 18ms);
	}

	.track-sidebar.is-ready .track-lessons :global(.top-level > li > details > ul > li) {
		opacity: 1;
		transform: translateY(0);
	}

	@keyframes track-loading {
		from { transform: scaleX(0); }
		to { transform: scaleX(1); }
	}

	@media (prefers-reduced-motion: reduce) {
		.track-picker,
		.track-lessons,
		.track-lessons :global(.top-level > li > details > ul > li) {
			transition: none;
		}

		.track-sidebar.is-switching .select-shell::after { animation: none; }
	}
</style>
