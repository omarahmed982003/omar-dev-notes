---
interface Props {
	locale: 'ar' | 'en';
}

const { locale } = Astro.props;
const isArabic = locale === 'ar';

// Count lesson files at build time so homepage numbers cannot become stale.
const docModules = import.meta.glob('../content/docs/**/*.{md,mdx}');
const trackSlugs = ['programming-basics', 'cpp', 'php', 'php-runtime', 'oop', 'auth', 'database'] as const;

const countLessons = (track: (typeof trackSlugs)[number], language: 'ar' | 'en') => {
	const prefix = language === 'ar'
		? `../content/docs/${track}/`
		: `../content/docs/en/${track}/`;

	return Object.keys(docModules).filter((path) => {
		if (!path.startsWith(prefix)) return false;
		if (track === 'cpp' && /\/loops-competitive\/(?:02-competitive-programming|03-conditions-codeforces)\.(?:md|mdx)$/.test(path)) return false;
		return !/\/(?:index|networking-next|programming-practice)\.(?:md|mdx)$/.test(path);
	}).length;
};

const lessonCounts = Object.fromEntries(
	trackSlugs.map((track) => [track, countLessons(track, locale)]),
) as Record<(typeof trackSlugs)[number], number>;
const totalLessons = trackSlugs.reduce((total, track) => total + countLessons(track, locale), 0);

const content = isArabic
	? {
			eyebrow: 'مكتبة لتعلّم البرمجة',
			title: 'افهم البرمجة خطوة بخطوة، من غير ما تحفظ كلام مش فاهمه.',
			description:
				'ابدأ باستخدام الكمبيوتر وحفظ الملفات، ثم اكتب أول برنامج واختر لغة تكمل بها. أقسام التوسع واضحة ومنفصلة عن طريق البداية.',
			primary: { label: 'ابدأ من الصفر', href: '/programming-basics/' },
			secondary: { label: 'شوف كل المسارات', href: '#learning-paths' },
			download: { label: 'نزّل نسخة PDF', href: '/downloads/omar-dev-notes-complete.pdf' },
			stats: [
				{ value: String(totalLessons), label: 'درس' },
				{ value: '7', label: 'مسارات' },
				{ value: 'AR · EN', label: 'لغتان' },
			],
			flowTitle: 'لو محتار تبدأ منين',
			flowLabel: 'رحلة التعلّم المقترحة',
			sectionTitle: 'اختار اللي محتاج تتعلّمه',
			sectionDescription: 'لو لسه في البداية امشِ بالترتيب، ولو عندك أساس كويس ادخل على المسار اللي محتاجه مباشرة.',
			lessonLabel: 'دروس',
			paths: [
				{
					code: '01',
					title: 'أساسيات الكمبيوتر والبرمجة والشبكات',
					description: 'اتعلم استخدام الجهاز، وابنِ برنامجًا يستقبل بيانات ويحفظها، ثم اتوسع في الرياضيات وداخل الكمبيوتر والشبكات.',
					href: '/programming-basics/',
					count: lessonCounts['programming-basics'],
					level: 'البداية',
					accent: 'blue',
				},
				{
					code: '02',
					title: 'البرمجة بلغة C++',
					description: 'اتعلّم كتابة البرامج من أول القيم والمتغيرات لحد الشروط والتكرار وبناء مشروعات صغيرة.',
					href: '/cpp/',
					count: lessonCounts.cpp,
					level: 'مبتدئ ← متوسط',
					accent: 'orange',
				},
				{
					code: '03',
					title: 'تطوير الويب بلغة PHP',
					description: 'اتعلّم أساسيات اللغة واستخدمها في استقبال الطلبات والتعامل مع الملفات والجلسات.',
					href: '/php/',
					count: lessonCounts.php,
					level: 'مبتدئ ← متوسط',
					accent: 'violet',
				},
				{
					code: '04',
					title: 'تشغيل تطبيقات PHP',
					description: 'افهم الأدوات والخدمات اللي بتشغّل تطبيق PHP وتخليه أسرع وأكثر استقرارًا.',
					href: '/php-runtime/',
					count: lessonCounts['php-runtime'],
					level: 'متوسط',
					accent: 'cyan',
				},
				{
					code: '05',
					title: 'تنظيم البرامج باستخدام الكائنات',
					description: 'نظّم الكود في أجزاء واضحة تمثل البيانات والسلوك، واعرف إمتى تستخدم كل طريقة.',
					href: '/oop/',
					count: lessonCounts.oop,
					level: 'متوسط',
					accent: 'amber',
				},
				{
					code: '06',
					title: 'الأمان وتسجيل الدخول والصلاحيات',
					description: 'احمِ المستخدم وبياناته، وحدد مين يقدر يدخل ومين يقدر ينفّذ كل عملية.',
					href: '/auth/',
					count: lessonCounts.auth,
					level: 'متوسط ← متقدم',
					accent: 'rose',
				},
				{
					code: '07',
					title: 'قواعد البيانات',
					description: 'خزّن البيانات واقرأها وعدّلها بأمان، واتعلّم تنظمها عشان تفضل سريعة وواضحة.',
					href: '/database/',
					count: lessonCounts.database,
					level: 'متوسط',
					accent: 'green',
				},
			],
		}
	: {
			eyebrow: 'A programming learning library',
			title: 'Understand programming step by step, without memorizing what you do not understand.',
			description:
				'Start with using a computer and saving files, then write your first program and choose a language. Later reference sections are separate from the beginner route.',
			primary: { label: 'Start from zero', href: '/en/programming-basics/' },
			secondary: { label: 'See all tracks', href: '#learning-paths' },
			download: { label: 'Download the complete PDF', href: '/downloads/omar-dev-notes-complete.pdf' },
			stats: [
				{ value: String(totalLessons), label: 'practical lessons' },
				{ value: '7', label: 'connected tracks' },
				{ value: 'AR · EN', label: 'Arabic and English' },
			],
			flowTitle: 'Not sure where to begin?',
			flowLabel: 'Suggested learning journey',
			sectionTitle: 'Choose what you need to learn',
			sectionDescription: 'Follow the order if you are new, or open the track you need if you already know the basics.',
			lessonLabel: 'lessons',
			paths: [
				{
					code: '01',
					title: 'Computer, programming, and networking fundamentals',
					description: 'Learn computer use, build a program that reads and saves data, then explore mathematics, computer internals, and networks.',
					href: '/en/programming-basics/',
					count: lessonCounts['programming-basics'],
					level: 'Start here',
					accent: 'blue',
				},
				{
					code: '02',
					title: 'Programming with C++',
					description: 'Write programs from values and variables through decisions, repetition, and small projects.',
					href: '/en/cpp/',
					count: lessonCounts.cpp,
					level: 'Beginner → intermediate',
					accent: 'orange',
				},
				{
					code: '03',
					title: 'Web development with PHP',
					description: 'Learn the language and use it to handle requests, files, and user sessions.',
					href: '/en/php/',
					count: lessonCounts.php,
					level: 'Beginner → intermediate',
					accent: 'violet',
				},
				{
					code: '04',
					title: 'Running PHP applications',
					description: 'Understand the tools and services that keep a PHP application fast and reliable.',
					href: '/en/php-runtime/',
					count: lessonCounts['php-runtime'],
					level: 'Intermediate',
					accent: 'cyan',
				},
				{
					code: '05',
					title: 'Organizing programs with objects',
					description: 'Organize code into clear parts that represent data and behavior, and learn when each approach helps.',
					href: '/en/oop/',
					count: lessonCounts.oop,
					level: 'Intermediate',
					accent: 'amber',
				},
				{
					code: '06',
					title: 'Security, sign-in, and permissions',
					description: 'Protect users and their data, then control who can enter and perform each action.',
					href: '/en/auth/',
					count: lessonCounts.auth,
					level: 'Intermediate → advanced',
					accent: 'rose',
				},
				{
					code: '07',
					title: 'Databases',
					description: 'Store, read, and update data safely, then organize it so it stays fast and clear.',
					href: '/en/database/',
					count: lessonCounts.database,
					level: 'Intermediate',
					accent: 'green',
				},
			],
		};

const arrow = isArabic ? '←' : '→';
---

<div class="home-shell">
	<section class="home-hero" aria-labelledby="home-title">
		<div class="hero-copy">
			<p class="eyebrow"><span aria-hidden="true"></span>{content.eyebrow}</p>
			<h1 id="home-title">{content.title}</h1>
			<p class="hero-description">{content.description}</p>
			<div class="hero-actions">
				<a class="primary-action" href={content.primary.href}>
					{content.primary.label}<span aria-hidden="true">{arrow}</span>
				</a>
				<a class="secondary-action" href={content.secondary.href}>
					{content.secondary.label}<span aria-hidden="true">{arrow}</span>
				</a>
				<button
					type="button"
					class="download-action"
					data-docs-download
					data-download-url={content.download.href}
				>
					<span aria-hidden="true">↓</span>{content.download.label}
				</button>
			</div>
			<ul class="learning-stats" aria-label={isArabic ? 'ملخص المحتوى' : 'Content summary'}>
				{content.stats.map((stat) => (
					<li>
						<strong>{stat.value}</strong>
						<span>{stat.label}</span>
					</li>
				))}
			</ul>
		</div>

		<div class="request-visual" role="img" aria-label={content.flowLabel}>
			<div class="visual-topbar">
				<span>{content.flowTitle}</span>
				<strong>{isArabic ? 'رحلة تعلّم واضحة' : 'A clear learning journey'}</strong>
			</div>
			{[
				isArabic ? ['افهم الأساس', 'الكمبيوتر والمنطق'] : ['Learn the foundation', 'Computers and logic'],
				isArabic ? ['حل المشكلة', 'قسّمها لخطوات'] : ['Solve the problem', 'Break it into steps'],
				isArabic ? ['اكتب الكود', 'طبّق بإيدك'] : ['Write the code', 'Practice it yourself'],
				isArabic ? ['ابنِ تطبيقًا', 'اربط الأجزاء'] : ['Build an application', 'Connect the pieces'],
				isArabic ? ['شغّله بأمان', 'اختبر واحمِ البيانات'] : ['Run it safely', 'Test and protect data'],
			].map((step, index) => (
				<div class="flow-line">
					<span class="flow-number">{String(index + 1).padStart(2, '0')}</span>
					<div><b>{step[0]}</b><small>{step[1]}</small></div>
				</div>
			))}
		</div>
	</section>

	<section class="study-method" aria-labelledby="method-title">
		<div class="section-heading">
			<div>
				<p class="section-kicker">{isArabic ? 'طريقة المذاكرة' : 'How to study'}</p>
				<h2 id="method-title">{isArabic ? 'كل درس له هدف واضح' : 'Every lesson has a clear purpose'}</h2>
			</div>
			<p>{isArabic ? 'مش مطلوب تحفظ كل حاجة من أول مرة. افهم الفكرة، جرّبها بإيدك، وبعدها راجع النتيجة وسبب أي خطأ.' : 'You do not need to memorize everything on the first pass. Understand the idea, try it, then review the result and any error.'}</p>
		</div>
		<div class="method-grid">
			{[
				isArabic ? ['01', 'افهم الفكرة', 'ابدأ بالمشكلة اللي الدرس بيحلها، وبعدها اتعرّف على المصطلحات واحدة واحدة.'] : ['01', 'Understand the idea', 'Start with the problem, then learn each new term one at a time.'],
				isArabic ? ['02', 'جرّب بإيدك', 'اكتب المثال وغيّر فيه؛ التجربة بتثبت الفكرة أكتر من القراءة.'] : ['02', 'Try it yourself', 'Type the example and change it; practice makes the idea stick.'],
				isArabic ? ['03', 'راجع النتيجة', 'قارن اللي حصل باللي توقعته، وافهم الخطأ بدل ما تنسخ الحل.'] : ['03', 'Review the result', 'Compare what happened with what you expected and understand errors.'],
			].map((item) => (
				<article><span>{item[0]}</span><h3>{item[1]}</h3><p>{item[2]}</p></article>
			))}
		</div>
	</section>

	<section class="learning-paths" id="learning-paths" aria-labelledby="paths-title">
		<div class="section-heading">
			<div>
				<p class="section-kicker">01 — 07</p>
				<h2 id="paths-title">{content.sectionTitle}</h2>
			</div>
			<p>{content.sectionDescription}</p>
		</div>

		<div class="paths-grid">
			{content.paths.map((path) => (
				<a class="path-card" data-accent={path.accent} href={path.href}>
					<div class="card-topline">
						<span class="path-code">{path.code}</span>
						<span class="path-arrow" aria-hidden="true">{arrow}</span>
					</div>
					<div class="card-copy">
						<h3>{path.title}</h3>
						<p>{path.description}</p>
					</div>
					<div class="card-meta">
						<span>{path.count} {content.lessonLabel}</span>
						<span>{path.level}</span>
					</div>
				</a>
			))}
		</div>
	</section>
</div>

<style>
	.home-shell {
		width: min(100%, 80rem);
		margin-inline: auto;
		padding: clamp(1rem, 2vw, 2rem) clamp(0.25rem, 2vw, 1.5rem) 5rem;
		overflow-x: clip;
	}

	.home-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.92fr);
		align-items: center;
		gap: clamp(2rem, 6vw, 5.5rem);
		min-height: 28rem;
		padding-block: 1.5rem 3.25rem;
	}

	.home-hero::before {
		position: absolute;
		z-index: -1;
		inset: 5% 0 auto auto;
		width: min(28rem, 80vw);
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(circle, color-mix(in srgb, var(--sl-color-accent) 16%, transparent), transparent 68%);
		content: '';
		filter: blur(10px);
		pointer-events: none;
	}

	.eyebrow,
	.section-kicker {
		margin: 0 0 1rem;
		color: var(--sl-color-accent);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.45rem 0.75rem;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 28%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--sl-color-accent-low) 58%, transparent);
	}

	.eyebrow > span {
		width: 0.48rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--sl-color-accent);
		box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
	}

	h1 {
		max-width: 15ch;
		margin: 0;
		color: var(--sl-color-white);
		font-size: clamp(2.6rem, 5vw, 4.7rem);
		font-weight: 760;
		letter-spacing: -0.055em;
		line-height: 1.04;
		text-wrap: balance;
	}

	:global([data-theme='light']) h1 {
		color: #0b1020;
	}

	.hero-description {
		max-width: 61ch;
		margin: 1.5rem 0 0;
		color: var(--sl-color-gray-2);
		font-size: clamp(1.04rem, 1.5vw, 1.2rem);
		line-height: 1.9;
	}

	:global([data-theme='light']) .hero-description {
		color: #465066;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.85rem;
	}

	.hero-actions a,
	.hero-actions button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		min-height: 3rem;
		padding: 0.72rem 1.1rem;
		border: 1px solid transparent;
		border-radius: 0.8rem;
		font-weight: 750;
		text-decoration: none;
		font: inherit;
		cursor: pointer;
		transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
	}

	.hero-actions a:hover,
	.hero-actions button:hover {
		transform: translateY(-2px);
	}

	.primary-action {
		background: linear-gradient(135deg, #4f46e5, #2563eb);
		box-shadow: 0 12px 30px rgb(37 99 235 / 22%);
		color: white;
	}

	.secondary-action {
		border-color: var(--sl-color-hairline) !important;
		background: color-mix(in srgb, var(--sl-color-bg-nav) 78%, transparent);
		color: var(--sl-color-text-accent);
	}

	.download-action {
		border-color: color-mix(in srgb, #22c55e 48%, var(--sl-color-hairline)) !important;
		background: color-mix(in srgb, #22c55e 11%, var(--sl-color-bg-nav));
		color: color-mix(in srgb, #22c55e 72%, var(--sl-color-text));
	}

	.download-action span {
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 999px;
		background: color-mix(in srgb, #22c55e 20%, transparent);
		font-size: 1rem;
		font-weight: 720;
	}

	.learning-stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0;
		margin: 2rem 0 0;
		padding: 0;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.9rem;
		background: color-mix(in srgb, var(--sl-color-bg-nav) 65%, transparent);
		box-shadow: 0 8px 24px rgb(2 6 23 / 5%);
		list-style: none;
	}

	.learning-stats li {
		display: grid;
		min-width: 7.2rem;
		gap: 0.1rem;
		padding: 0.75rem 0.95rem;
		border-inline-end: 1px solid var(--sl-color-hairline);
	}

	.learning-stats li:last-child { border-inline-end: 0; }

	.learning-stats strong {
		color: var(--sl-color-white);
		font-size: 1.15rem;
	}

	:global([data-theme='light']) .learning-stats strong {
		color: #111827;
	}

	.learning-stats span {
		color: var(--sl-color-gray-3);
		font-size: 0.78rem;
		font-weight: 650;
	}

	.request-visual {
		overflow: hidden;
		padding: 1.1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1.25rem;
		background: color-mix(in srgb, var(--sl-color-bg-nav) 82%, transparent);
		box-shadow: var(--docs-shadow);
		transition: transform 220ms ease, box-shadow 220ms ease;
	}

	.request-visual:hover {
		box-shadow: 0 24px 55px rgb(2 6 23 / 14%);
		transform: translateY(-3px);
	}

	.visual-topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: .35rem .35rem 1rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		color: var(--sl-color-gray-3);
		font-size: .75rem;
		font-weight: 700;
	}

	.visual-topbar strong { color: var(--sl-color-white); font-size: .82rem; }

	.flow-line {
		display: grid;
		grid-template-columns: 2.25rem 1fr;
		align-items: center;
		gap: 0.75rem;
		margin-top: .7rem;
		padding: .7rem .75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.75rem;
		background: color-mix(in srgb, var(--sl-color-accent) 3%, transparent);
	}

	.flow-line div { display: grid; gap: .12rem; }
	.flow-line b { color: var(--sl-color-white); font-size: .9rem; }
	.flow-line small { color: var(--sl-color-gray-3); font-size: .73rem; }

	.flow-number {
		display: grid;
		width: 2.2rem;
		height: 2.2rem;
		place-items: center;
		border-radius: 50%;
		background: color-mix(in srgb, var(--sl-color-accent) 13%, transparent);
		color: var(--sl-color-text-accent);
		font-size: .68rem;
		font-weight: 850;
	}

	.study-method,
	.learning-paths { padding-top: 4rem; border-top: 1px solid var(--sl-color-hairline); }

	.section-heading {
		display: grid;
		grid-template-columns: 1fr minmax(18rem, 31rem);
		align-items: end;
		gap: 2rem;
		margin-bottom: 1.5rem;
	}

	.section-heading h2 {
		margin: 0;
		color: var(--sl-color-white);
		font-size: clamp(2rem, 3.5vw, 3.2rem);
		letter-spacing: -0.04em;
		line-height: 1.08;
	}

	:global([data-theme='light']) .section-heading h2 {
		color: #111827;
	}

	.section-heading > p {
		margin: 0;
		color: var(--sl-color-gray-3);
		line-height: 1.75;
	}

	.paths-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.path-card:last-child {
		grid-column: 1 / -1;
		min-height: 11.5rem;
	}

	.path-card:last-child .card-copy p { max-width: 72ch; }

	.method-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		overflow: hidden;
		margin-bottom: 4rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1rem;
		background: color-mix(in srgb, var(--sl-color-bg-nav) 76%, transparent);
	}

	.method-grid article { padding: 1.35rem; }
