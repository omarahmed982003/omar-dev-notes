---
import foundationsCurriculum from '../data/foundations-curriculum.json';
interface Props {
	locale: 'ar' | 'en';
}

const { locale } = Astro.props;
const isArabic = locale === 'ar';

// Count lesson files at build time so homepage numbers cannot become stale.
const docModules = import.meta.glob('../content/docs/**/*.{md,mdx}');
const trackSlugs = ['programming-basics', 'php'] as const;

const countLessons = (track: (typeof trackSlugs)[number], language: 'ar' | 'en') => {
	const prefix = language === 'ar'
		? `../content/docs/${track}/`
		: `../content/docs/en/${track}/`;

	return Object.keys(docModules).filter((path) => {
		const runtimePrefix = language === 'ar' ? '../content/docs/php-runtime/' : '../content/docs/en/php-runtime/';
		if (!path.startsWith(prefix) && !(track === 'php' && path.startsWith(runtimePrefix))) return false;
		if (track === 'programming-basics') {
			const route = 'programming-basics/' + path.slice(prefix.length).replace(/\.(?:md|mdx)$/, '');
			if (!foundationsCurriculum.some(group => group.lessons.includes(route))) return false;
		}
		return !/\/(?:index|networking-next|programming-practice)\.(?:md|mdx)$/.test(path);
	}).length;
};

const lessonCounts = Object.fromEntries(
	trackSlugs.map((track) => [track, countLessons(track, locale)]),
) as Record<(typeof trackSlugs)[number], number>;
const totalLessons = trackSlugs.reduce((total, track) => total + countLessons(track, locale), 0);

const content = isArabic
	? {
			eyebrow: 'مكتبة لتعلّم البرمجة',
			title: ['افهم الفكرة.', 'واكتب الكود بثقة.'],
			description:
				'افهم جهازك ونظام التشغيل، واعرف كودك بيتنفذ إزاي وبيتعامل مع الذاكرة والملفات والشبكة. بعدها اختار اللغة والمسار اللي محتاجه.',
			primary: { label: 'ابدأ من الصفر', href: '/programming-basics/' },
			secondary: { label: 'شوف كل المسارات', href: '#learning-paths' },
			download: { label: 'نزّل نسخة PDF', href: '/downloads/omar-dev-notes-complete.pdf' },
			stats: [
				{ value: String(totalLessons), label: 'درس' },
				{ value: String(trackSlugs.length), label: 'مسارات' },
				{ value: 'AR · EN', label: 'لغتان' },
			],
			flowTitle: 'لو محتار تبدأ منين',
			flowLabel: 'رحلة التعلّم المقترحة',
			sectionTitle: 'اختار اللي محتاج تتعلّمه',
			sectionDescription: 'لو لسه في البداية امشِ بالترتيب، ولو عندك أساس كويس ادخل على المسار اللي محتاجه مباشرة.',
			lessonLabel: 'دروس',
			paths: [
				{
					code: '01',
					title: 'أساسيات الكمبيوتر والبرمجة والشبكات',
					description: 'من الهاردوير لنظام التشغيل وتنفيذ البرامج والذاكرة والملفات، وبعدها الشبكات والويب والتفكير في حل المشكلات.',
					href: '/programming-basics/',
					count: lessonCounts['programming-basics'],
					level: 'البداية',
					accent: 'blue',
				},
				{
					code: '02',
					title: 'PHP: من أساس اللغة لتشغيل التطبيقات',
					description: 'اتعلّم اللغة وابنِ تطبيق ويب، وبعدها افهم Composer وPHP-FPM والاختبارات والأداء والنشر؛ مسار واحد بمراحل واضحة.',
					href: '/php/',
					count: lessonCounts.php,
					level: 'مبتدئ ← متقدم',
					accent: 'violet',
				},
			],
		}
	: {
			eyebrow: 'A programming learning library',
			title: ['Understand the idea.', 'Build with confidence.'],
			description:
				'Understand your hardware and operating system, how code runs, and how programs use memory, files, and networks. Then choose the language and track you need.',
			primary: { label: 'Start from zero', href: '/en/programming-basics/' },
			secondary: { label: 'See all tracks', href: '#learning-paths' },
			download: { label: 'Download the complete PDF', href: '/downloads/omar-dev-notes-complete.pdf' },
			stats: [
				{ value: String(totalLessons), label: 'practical lessons' },
				{ value: String(trackSlugs.length), label: 'connected tracks' },
				{ value: 'AR · EN', label: 'Arabic and English' },
			],
			flowTitle: 'Not sure where to begin?',
			flowLabel: 'Suggested learning journey',
			sectionTitle: 'Choose what you need to learn',
			sectionDescription: 'Follow the order if you are new, or open the track you need if you already know the basics.',
			lessonLabel: 'lessons',
			paths: [
				{
					code: '01',
					title: 'Computer, programming, and networking fundamentals',
					description: 'Start with hardware, operating systems, program execution, memory, and files; then explore networks, the web, and problem solving.',
					href: '/en/programming-basics/',
					count: lessonCounts['programming-basics'],
					level: 'Start here',
					accent: 'blue',
				},
				{
					code: '02',
					title: 'PHP: Language, Applications & Production',
					description: 'Learn PHP, build a web application, then explore Composer, PHP-FPM, testing, performance, and deployment in one staged track.',
					href: '/en/php/',
					count: lessonCounts.php,
					level: 'Beginner → advanced',
					accent: 'violet',
				},
			],
		};

const arrow = isArabic ? '←' : '→';
---


<div class="home-shell">
	<div class="library-bar">
		<span dir="ltr">OMAR <span aria-hidden="true">/</span> DEV NOTES</span>
		<span>{isArabic ? 'دروس تفهمها. وتطبيق يثبتها.' : 'Learn the why. Practice the how.'}</span>
	</div>

	<section class="home-hero" aria-labelledby="home-title">
		<div class="hero-copy">
			<p class="eyebrow"><span aria-hidden="true"></span>{content.eyebrow}</p>
			<h1 id="home-title">{content.title[0]}<span>{content.title[1]}</span></h1>
			<p class="hero-description">{content.description}</p>
			<div class="hero-actions">
				<a class="primary-action" href={content.primary.href}>{content.primary.label}<span aria-hidden="true">{arrow}</span></a>
				<a class="secondary-action" href={content.secondary.href}>{content.secondary.label}<span aria-hidden="true">↓</span></a>
			</div>
			<ul class="learning-stats" aria-label={isArabic ? 'ملخص المحتوى' : 'Content summary'}>
				{content.stats.map((stat) => <li><strong dir="auto">{stat.value}</strong><span>{stat.label}</span></li>)}
			</ul>
		</div>

		<aside class="learning-notebook" aria-labelledby="journey-title">
			<div class="notebook-top">
				<span class="notebook-label" dir="ltr"><span aria-hidden="true">⌘</span> YOUR LEARNING PATH</span>
				<span class="notebook-edition" dir="ltr">01 — 05</span>
			</div>
			<h2 id="journey-title">{content.flowTitle}</h2>
			<p class="notebook-intro">{isArabic ? 'كل خطوة بتبني على اللي قبلها.' : 'Every step builds on the one before it.'}</p>
			<ol class="journey-list">
				{[
					isArabic ? ['افهم الأساس', 'الكمبيوتر والمنطق'] : ['Learn the foundation', 'Computers and logic'],
					isArabic ? ['حل المشكلة', 'قسّمها لخطوات'] : ['Solve the problem', 'Break it into steps'],
					isArabic ? ['اكتب الكود', 'طبّق بإيدك'] : ['Write the code', 'Practice it yourself'],
					isArabic ? ['ابنِ تطبيقًا', 'اربط الأجزاء'] : ['Build an application', 'Connect the pieces'],
					isArabic ? ['شغّله بأمان', 'اختبر واحمِ البيانات'] : ['Run it safely', 'Test and protect data'],
				].map((step, index) => (
					<li class="journey-step">
						<span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
						<div><b>{step[0]}</b><span>{step[1]}</span></div>
						{index === 0 && <span class="start-label">{isArabic ? 'ابدأ هنا' : 'START HERE'}</span>}
					</li>
				))}
			</ol>
			<div class="notebook-footer"><span aria-hidden="true">↳</span>{isArabic ? 'افهم، جرّب، وبعدها كمّل.' : 'Understand, experiment, then move on.'}</div>
		</aside>
	</section>

	<section class="learning-paths" id="learning-paths" aria-labelledby="paths-title">
		<div class="section-heading">
			<div><p class="section-kicker">{isArabic ? 'المسارات المتاحة' : 'EXPLORE THE LIBRARY'}</p><h2 id="paths-title">{content.sectionTitle}</h2></div>
			<p>{content.sectionDescription}</p>
		</div>
		<div class="paths-grid">
			{content.paths.map((path) => (
				<a class="path-card" data-accent={path.accent} href={path.href}>
					<div class="card-topline">
						<span class="path-icon" aria-hidden="true">
							{path.code === '01'
								? <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="4" width="22" height="17" rx="3"/><path d="M12 27h8M16 21v6M12 9l-3 3 3 3m8-6 3 3-3 3m-3-7-2 9"/></svg>
								: <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="26" height="22" rx="3"/><path d="M3 11h26M7 8h1m2 0h1m-1 8-3 3 3 3m5-6-2 8m7-8 3 3-3 3"/></svg>}
						</span>
						<span class="path-code">{isArabic ? 'المسار' : 'TRACK'} / {path.code}</span>
					</div>
					<div class="card-copy"><h3>{path.title}</h3><p>{path.description}</p></div>
					<ul class="path-topics" aria-label={isArabic ? 'موضوعات المسار' : 'Track topics'}>
						{(path.code === '01' ? ['Computer & OS', 'Networks', 'Problem solving'] : ['PHP', 'Web applications', 'Production']).map(topic => <li dir="ltr">{topic}</li>)}
					</ul>
					<div class="card-bottom">
						<div class="card-meta"><span>{path.count} {content.lessonLabel}</span><span>{path.level}</span></div>
						<span class="path-arrow" aria-hidden="true">{arrow}</span>
					</div>
				</a>
			))}
		</div>
	</section>

	<section class="study-method" aria-labelledby="method-title">
		<div class="section-heading">
			<div><p class="section-kicker">{isArabic ? 'طريقة المذاكرة' : 'MAKE IT STICK'}</p><h2 id="method-title">{isArabic ? 'كل درس له هدف واضح' : 'Every lesson has a clear purpose'}</h2></div>
			<p>{isArabic ? 'مش مطلوب تحفظ كل حاجة من أول مرة. افهم الفكرة، جرّبها بإيدك، وبعدها راجع النتيجة وسبب أي خطأ.' : 'You do not need to memorize everything on the first pass. Understand the idea, try it, then review the result and any error.'}</p>
		</div>
		<div class="method-grid">
			{[
				isArabic ? ['01', 'افهم الفكرة', 'ابدأ بالمشكلة اللي الدرس بيحلها، وبعدها اتعرّف على المصطلحات واحدة واحدة.'] : ['01', 'Understand the idea', 'Start with the problem, then learn each new term one at a time.'],
				isArabic ? ['02', 'جرّب بإيدك', 'اكتب المثال وغيّر فيه؛ التجربة بتثبت الفكرة أكتر من القراءة.'] : ['02', 'Try it yourself', 'Type the example and change it; practice makes the idea stick.'],
				isArabic ? ['03', 'راجع النتيجة', 'قارن اللي حصل باللي توقعته، وافهم الخطأ بدل ما تنسخ الحل.'] : ['03', 'Review the result', 'Compare what happened with what you expected and understand errors.'],
			].map(item => <article><span class="method-number" aria-hidden="true">{item[0]}</span><h3>{item[1]}</h3><p>{item[2]}</p></article>)}
		</div>
	</section>

	<footer class="home-footer">
		<div><span class="footer-mark" aria-hidden="true">&lt;/&gt;</span><p>{isArabic ? 'مرجعك مفتوح، كل ما تحتاج ترجع.' : 'A reference to come back to, whenever you need it.'}</p></div>
		<button type="button" class="download-action" data-docs-download data-download-url={content.download.href}><span aria-hidden="true">↓</span>{content.download.label}</button>
	</footer>
</div>

<style>
	.home-shell { width: min(100%, 78rem); margin-inline: auto; padding: 1.75rem clamp(0.25rem, 2vw, 1.25rem) 1.5rem; }
	.library-bar { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--docs-border); color: var(--sl-color-gray-3); font-size: 0.75rem; }
	.library-bar > span:first-child { font: 600 0.7rem/1.8 var(--sl-font-mono); letter-spacing: 0.1em; }
	.library-bar > span:first-child span { color: var(--sl-color-accent); margin-inline: 0.35rem; }
	.home-hero { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr); align-items: center; gap: clamp(2rem, 5vw, 5.5rem); padding-block: clamp(2.5rem, 6vw, 5rem) 4rem; }
	.eyebrow, .section-kicker { color: var(--sl-color-text-accent); font-size: 0.78rem; font-weight: 700; }
	.eyebrow { display: flex; align-items: center; gap: 0.65rem; margin: 0 0 1.4rem; }
	.eyebrow > span { width: 0.5rem; height: 0.5rem; background: var(--sl-color-accent); border-radius: 50%; }
	h1 { margin: 0; color: var(--sl-color-white); font-size: clamp(2.6rem, 4.8vw, 4.8rem); font-weight: 750; letter-spacing: -0.045em; line-height: 1.18; }
	h1 > span { display: block; color: var(--sl-color-white); }
	:global([lang='ar']) h1 { font-size: clamp(2.2rem, 3.4vw, 3.7rem); line-height: 1.65; letter-spacing: -0.035em; }
	.hero-description { max-width: 53ch; margin-block: 1.4rem 0; color: var(--sl-color-gray-2); font-size: 1.04rem; line-height: 1.95; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.8rem; }
	.hero-actions a { display: inline-flex; align-items: center; justify-content: center; gap: 1rem; min-height: 3.2rem; padding: 0.7rem 1.25rem; border: 1px solid var(--docs-border); border-radius: 0.6rem; font-size: 0.91rem; font-weight: 700; text-decoration: none; transition: background-color 160ms ease, transform 160ms ease; }
	.primary-action { color: var(--docs-button-text); background: var(--docs-button-bg); border-color: var(--docs-button-bg) !important; }
	.primary-action:hover { background: color-mix(in srgb, var(--docs-button-bg) 88%, var(--sl-color-accent)); transform: translateY(-2px); }
	.secondary-action { color: var(--sl-color-white); background: var(--docs-surface); }
	.secondary-action:hover { background: var(--sl-color-accent-low); }
	.learning-stats { display: flex; gap: 2rem; padding: 0; margin: 2.1rem 0 0; list-style: none; }
	.learning-stats li { display: flex; align-items: baseline; gap: 0.45rem; }
	.learning-stats strong { color: var(--sl-color-white); font: 650 1.1rem/1.5 var(--sl-font-mono); }
	.learning-stats span { font-size: 0.75rem; color: var(--sl-color-gray-3); }
	.learning-notebook { position: relative; padding: 1.5rem; border: 1px solid var(--docs-border); border-radius: 0.75rem; color: var(--sl-color-gray-2); background: var(--docs-surface); box-shadow: none; }
	.notebook-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--docs-border); }
	.notebook-label, .notebook-edition { font: 500 0.75rem/1.5 var(--sl-font-mono); letter-spacing: 0.06em; color: var(--sl-color-gray-3); }
	.notebook-label { display: flex; align-items: center; gap: 0.5rem; }
	.notebook-label > span { font-size: 1rem; color: var(--sl-color-text-accent); }
	.learning-notebook h2 { font-size: 1.2rem; line-height: 1.65; color: var(--sl-color-white); margin: 1.4rem 0 0.3rem; }
	.notebook-intro { margin: 0; color: var(--sl-color-gray-3); font-size: 0.8rem; }
	.journey-list { margin: 1.35rem 0 0; padding: 0; list-style: none; }
	.journey-step { display: flex; align-items: center; gap: 0.85rem; position: relative; min-height: 4rem; }
	.journey-step:not(:last-child)::before { position: absolute; content: ''; inset-inline-start: 1rem; top: 2.8rem; bottom: -0.55rem; width: 1px; background: var(--docs-border); }
	.step-number { position: relative; z-index: 1; display: grid; place-items: center; flex: 0 0 2rem; height: 2rem; border: 1px solid var(--docs-border); border-radius: 50%; background: var(--docs-surface); color: var(--sl-color-gray-2); font: 500 0.68rem/1 var(--sl-font-mono); }
	.journey-step:first-child .step-number { color: var(--docs-button-text); background: var(--docs-button-bg); border-color: var(--docs-button-bg); }
	.journey-step > div { display: grid; gap: 0.12rem; }
	.journey-step b { font-size: 0.88rem; font-weight: 600; color: var(--sl-color-white); }
	.journey-step div > span { font-size: 0.72rem; color: var(--sl-color-gray-3); }
	.start-label { margin-inline-start: auto; padding: 0.24rem 0.45rem; border-radius: 0.3rem; color: var(--sl-color-text-accent); background: var(--sl-color-gray-6); font-size: 0.72rem; white-space: nowrap; }
	.notebook-footer { display: flex; gap: 0.5rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--docs-border); color: var(--sl-color-gray-3); font-size: 0.72rem; }
	.learning-paths { scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem); padding-block: 2rem 4rem; }
	.section-heading { display: grid; grid-template-columns: 1fr minmax(14rem, 27rem); align-items: end; gap: 2rem; margin-bottom: 1.75rem; }
	.section-kicker { margin: 0 0 0.7rem; letter-spacing: 0.04em; }
	.section-heading h2 { margin: 0; color: var(--sl-color-white); font-size: clamp(1.6rem, 2.2vw, 2.25rem); font-weight: 700; line-height: 1.6; letter-spacing: -0.03em; }
	.section-heading > p { margin: 0; color: var(--sl-color-gray-3); font-size: 0.9rem; line-height: 1.9; }
	.paths-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.3rem; }
	.path-card { --card-color: #60a5fa; position: relative; display: flex; flex-direction: column; gap: 1.25rem; padding: clamp(1.25rem, 2.5vw, 2rem); border: 1px solid var(--docs-border); border-radius: 0.85rem; background: var(--docs-surface); text-decoration: none; color: var(--sl-color-gray-2); transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease; }
	.path-card[data-accent='violet'] { --card-color: #a78bfa; }
	:global([data-theme='dark']) .path-card { --card-color: #60a5fa; }
	:global([data-theme='dark']) .path-card[data-accent='violet'] { --card-color: #a78bfa; }
	.path-card:hover { transform: translateY(-4px); border-color: var(--card-color); box-shadow: var(--docs-shadow); }
	.path-card:focus-visible, .hero-actions a:focus-visible, .download-action:focus-visible { outline: 3px solid var(--sl-color-accent); outline-offset: 4px; }
	.card-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
	.path-icon { display: grid; place-items: center; width: 3.15rem; height: 3.15rem; border-radius: 0.7rem; color: var(--card-color); background: color-mix(in srgb, var(--card-color) 9%, var(--docs-surface)); }
	.path-icon svg { width: 2rem; height: 2rem; }
	.path-code { color: var(--sl-color-gray-3); font: 500 0.67rem/1.7 var(--sl-font-mono); }
	.card-copy { margin-block: 0 auto; }
	.card-copy h3 { margin: 0; color: var(--sl-color-white); font-size: 1.22rem; font-weight: 700; line-height: 1.75; }
	.card-copy p { margin: 0.7rem 0 0; color: var(--sl-color-gray-2); font-size: 0.89rem; line-height: 1.9; }
	.path-topics { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
	.path-topics li { padding: 0.23rem 0.55rem; border: 1px solid var(--docs-border); border-radius: 0.35rem; color: var(--sl-color-gray-3); font-size: 0.67rem; }
	.card-bottom { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding-top: 1.1rem; border-top: 1px solid var(--docs-border); }
	.card-meta { display: flex; flex-wrap: wrap; gap: 0.7rem; font-size: 0.76rem; color: var(--sl-color-gray-3); }
	.card-meta > span + span::before { content: '·'; margin-inline-end: 0.7rem; }
	.path-arrow { display: grid; place-items: center; flex: 0 0 2.3rem; height: 2.3rem; border: 1px solid var(--docs-border); border-radius: 50%; color: var(--card-color); font-size: 1.2rem; }
	.study-method { padding-block: 2.5rem 4rem; border-top: 1px solid var(--docs-border); }
	.method-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
	.method-grid article { position: relative; padding-inline-start: 3.35rem; }
	.method-number { position: absolute; inset-inline-start: 0; top: 0.25rem; display: grid; place-items: center; width: 2.3rem; height: 2.3rem; border: 1px solid var(--docs-border); border-radius: 50%; font: 500 0.7rem/1 var(--sl-font-mono); color: var(--sl-color-text-accent); }
	.method-grid h3 { margin: 0 0 0.7rem; color: var(--sl-color-white); font-size: 1rem; line-height: 1.9; }
	.method-grid p { margin: 0; color: var(--sl-color-gray-3); font-size: 0.85rem; line-height: 1.85; }
	.home-footer { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 1.5rem; border-top: 1px solid var(--docs-border); }
	.home-footer > div { display: flex; align-items: center; gap: 0.75rem; }
	.footer-mark { color: var(--sl-color-text-accent); font: 600 1rem/1 var(--sl-font-mono); }
	.home-footer p { margin: 0; color: var(--sl-color-gray-3); font-size: 0.8rem; }
	.download-action { display: inline-flex; align-items: center; gap: 0.7rem; min-height: 2.75rem; padding: 0.5rem 0.8rem; border: 1px solid var(--docs-border); border-radius: 0.5rem; background: var(--docs-surface); color: var(--sl-color-white); font: 500 0.8rem/1.6 var(--sl-font); cursor: pointer; }
