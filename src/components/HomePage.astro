<script>
	const downloadButton = document.querySelector<HTMLButtonElement>('[data-docs-download]');

	downloadButton?.addEventListener('click', () => {
		const url = downloadButton.dataset.downloadUrl;
		if (!url) return;

		const link = document.createElement('a');
		link.href = url;
		link.download = 'omar-dev-notes-complete.pdf';
		link.style.display = 'none';
		document.body.append(link);
		link.click();
		link.remove();
	});
</script>
