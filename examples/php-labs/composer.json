{
  "name": "omar/lesson-labs",
  "description": "Executable examples for Omar Programming Library",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-sodium": "*",
    "ext-mbstring": "*",
    "nyholm/psr7": "^1.8",
    "open-telemetry/exporter-otlp": "^1.0",
    "open-telemetry/sdk": "^1.0",
    "php-http/guzzle7-adapter": "^1.0"
  },
  "autoload": { "psr-4": { "Lessons\\": "src/" } },
  "scripts": {
    "test": "@php tests.php",
    "verify-production": [
      "@php -r \"exit(is_file('production/compose.yaml') && is_file('production/compose.full.yaml') && is_file('production/nginx.conf') && is_file('production/app-pool.conf') && is_file('production/otel-collector.yaml') ? 0 : 1);\""
    ]
  },
  "config": {
    "platform": { "php": "8.4.0" },
    "sort-packages": true
  }
}
